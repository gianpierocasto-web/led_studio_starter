{"nodes": [{"id": "leggimi_blender", "label": "Blender 4.3", "file_type": "concept", "source_file": "LEGGIMI.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Il file \u00e8 generato e controllato in Blender 4.3.2 e va usato con Blender 4.3 o successivo."}, {"id": "leggimi_preset_8mm", "label": "Preset scena 8 mm", "file_type": "concept", "source_file": "LEGGIMI.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Scena selezionabile dal menu Scene. La denominazione \u00e8 un preset geometrico dimostrativo, non un prodotto certificato."}, {"id": "leggimi_preset_10mm", "label": "Preset scena 10 mm", "file_type": "concept", "source_file": "LEGGIMI.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Scena selezionabile dal menu Scene. Preset geometrico dimostrativo, non un prodotto certificato."}, {"id": "leggimi_preset_rgb_12mm", "label": "Preset scena RGB 12 mm", "file_type": "concept", "source_file": "LEGGIMI.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Preset geometrico dimostrativo. Usa un package quadrato con finestra scura e non \u00e8 un circuito elettronico RGB completo: componenti e contatti sono rappresentativi."}, {"id": "leggimi_configurazione_prodotto", "label": "Modificatore Configurazione prodotto", "file_type": "concept", "source_file": "LEGGIMI.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dal modificatore si cambiano quote, materiali e numero di raggi. Nel workspace Geometry Nodes si sceglie questo stesso modificatore."}, {"id": "leggimi_gruppo_00_prodotto_completo", "label": "00 Prodotto completo", "file_type": "concept", "source_file": "LEGGIMI.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Gruppo asset da assegnare a un modificatore Geometry Nodes per generare il prodotto da zero su una mesh, poi si assegnano i materiali nei socket."}, {"id": "leggimi_gruppo_01_percorso_spirale", "label": "01 Percorso spirale e uscita", "file_type": "concept", "source_file": "LEGGIMI.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Gruppo asset che descrive il percorso a spirale e il tratto di uscita."}, {"id": "leggimi_gruppo_02_pcb", "label": "02 PCB e componenti su curva", "file_type": "concept", "source_file": "LEGGIMI.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Contiene i blocchi package, fosforo, resistenza e contatti, con materiali gi\u00e0 separati. Pu\u00f2 essere riutilizzato su una curva diritta per produrre il dettaglio frontale."}, {"id": "leggimi_gruppo_03_bobina", "label": "03 Bobina parametrica", "file_type": "concept", "source_file": "LEGGIMI.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bobina di base con flange ad anello e raggi modificabili."}, {"id": "leggimi_append_collezione", "label": "Append collezione Prodotto", "file_type": "concept", "source_file": "LEGGIMI.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "File > Append > LED_Studio.blend > Collection > Prodotto importa la sola collezione prodotto, nodi e materiali collegati inclusi."}, {"id": "leggimi_sistema_quote", "label": "Sistema quote in metri", "file_type": "rationale", "source_file": "LEGGIMI.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "I valori numerici sono in metri: 0.008 = 8 mm. La larghezza si sviluppa verticalmente fra le flange. Il generatore non interpreta una lunghezza commerciale esatta: \u00e8 un avvolgimento illustrativo."}, {"id": "leggimi_vincolo_raggi", "label": "Vincolo sui raggi della bobina", "file_type": "rationale", "source_file": "LEGGIMI.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Va mantenuto Raggio mozzo < Raggio avvolgimento < Raggio bobina - 0.005, per lasciare l'avvolgimento dentro la bobina con un margine di 5 mm."}, {"id": "leggimi_arrotondamento_giri", "label": "Arrotondamento dei giri interni", "file_type": "rationale", "source_file": "LEGGIMI.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Il generatore arrotonda i giri interni per ottenere un'uscita ripetibile."}, {"id": "leggimi_gioco_flange", "label": "Gioco flange", "file_type": "concept", "source_file": "LEGGIMI.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Aumenta l'altezza della bobina senza allargare il PCB."}, {"id": "leggimi_uscita_libera", "label": "Giri uscita e Apertura uscita", "file_type": "concept", "source_file": "LEGGIMI.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Controllano il tratto libero dell'avvolgimento."}, {"id": "leggimi_passo_radiale", "label": "Passo radiale", "file_type": "concept", "source_file": "LEGGIMI.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u00c8 la distanza fra le spire, non la larghezza della striscia. Un avvolgimento troppo fitto pu\u00f2 intersecare i componenti."}, {"id": "leggimi_esclusioni_asset", "label": "Esclusioni del modello", "file_type": "concept", "source_file": "LEGGIMI.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": 